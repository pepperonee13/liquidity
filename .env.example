# Where the app is reachable from your browser. The bank redirect URL is
# ${PUBLIC_URL}/api/connections/callback and must be registered with the provider.
PUBLIC_URL=http://localhost:3000

# Enable Banking credentials (docs/BANK_SYNC.md). Leave empty to use only CSV import / demo data.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=/secrets/enablebanking.pem

# Hours between automatic bank syncs (0 disables). Banks allow about 4 unattended refreshes a day.
SYNC_INTERVAL_HOURS=6

# Set to 0 to hide the demo bank once you use real data.
DEMO_PROVIDER=1
